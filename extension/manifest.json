{
  "manifest_version": 3,
  "name": "Captura",
  "version": "1.3.0",
  "description": "Capture any page, annotate with arrows and shapes, then copy or share via Google Drive — no server needed.",

  "permissions": [
    "activeTab",
    "tabs",
    "identity",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "desktopCapture",
    "contextMenus",
    "offscreen"
  ],

  "host_permissions": [
    "https://www.googleapis.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Captura — Capture & Annotate",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "oauth2": {
    "client_id": "153536487889-crvhlcfpuigq4gegpgbmbft7kj1bok2c.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  }
}
